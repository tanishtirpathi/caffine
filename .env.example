# Copy this file to .env.local for local development.
# Keep real secrets out of source control.
# Example values are placeholders only.

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# JWT secret used for auth cookies and token verification
JWT_SECRET=replace_with_a_long_random_secret_string

# ImageKit config for image uploads/URL handling
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Redis connection for caching/queue-style usage
REDIS_URL=redis://127.0.0.1:6379

# Optional: local environment override
# NODE_ENV=development
